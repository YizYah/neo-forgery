{
  "name": "neo-forgery",
  "description": "the easy way to mock a neo4j-driver session",
  "author": "YizYah",
  "version": "1.10.0",
  "bugs": "https://github.com/YizYah/neo-forgery/issues",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib/**/*"
  ],
  "homepage": "https://github.com/YizYah/neo-forgery",
  "keywords": [
    "neo4j",
    "mock",
    "neo4j-driver",
    "test",
    "ts-packrat",
    "geenee"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": "YizYah/neo-forgery",
  "scripts": {
    "build": "tsc",
    "commit": "git-cz",
    "coverage": "nyc npm test",
    "int": "ava --config int-tests.config.cjs",
    "lint": "eslint \"src/**/*.ts\"",
    "lint-fix": "eslint \"src/**/*.ts\" --fix",
    "test": "ava",
    "fulltest": "npm run view-coverage && npm run report && npm run lint",
    "prepack": "rm -rf lib && tsc -b",
    "report": "nyc report --reporter=json",
    "semantic-release": "semantic-release",
    "view-coverage": "nyc --extension .ts ava --forbid-only"
  },
  "dependencies": {
    "@types/traverse": "^0.6.32",
    "deep-equal": "^2.0.5",
    "is-subset": "^0.1.1",
    "path": "^0.12.7",
    "traverse": "^0.6.6",
    "tslib": "^2.0.3"
  },
  "peerDependencies": {
    "neo4j-driver": ">=5 <7"
  },
  "devDependencies": {
    "@neo4j/graphql": "^7.0.0",
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^4.21.0",
    "@typescript-eslint/parser": "^4.21.0",
    "ava": "^6.1.0",
    "commitizen": "^4.2.3",
    "cz-conventional-changelog": "^3.2.0",
    "dotenv": "^10.0.0",
    "eslint": "^7.23.0",
    "ghooks": "^2.0.4",
    "graphql": "^16.8.0",
    "neo4j-driver": "^6.3.0",
    "nyc": "^15.1.0",
    "prettier": "^2.2.1",
    "proxyquire": "^2.1.3",
    "semantic-release": "^24.2.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "ava": {
    "files": [
      "test/**/*.test.ts"
    ],
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "concurrency": 4,
    "timeout": "60s"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    },
    "ghooks": {
      "pre-commit": "npm run test"
    }
  }
}
